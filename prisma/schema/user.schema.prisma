model User {
  id                 Int              @id @default(autoincrement())
  email              String           @unique
  password           String
  role               UserRole         @default(TOURIST)
  isPremium          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  name               String
  isDeleted          Boolean          @default(false)
  profilePhoto       String?
  needPasswordChange Boolean          @default(false)
  activeRole         UserRole         @default(TOURIST)
  travelRequest      TravelRequest[]
  profile            UserProfile?
  admin              Admin?
  hostApplications   HostApplication?
  host               Host?
  tourist            Tourist?

  @@map("users")
}

model UserProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  bio              String?
  interests        String[]
  visitedCountries String[]
  location         String?
  facebook         String?
  instagram        String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id           Int      @id @default(autoincrement())
  profilePhoto String?
  phone        String?
  userId       Int      @unique
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Host {
  id          Int          @id @default(autoincrement())
  userId      Int          @unique
  phone       String?
  address     String?
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  travelPlans TravelPlan[]

  @@map("hosts")
}

model Tourist {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  phone     String?
  country   String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tourists")
}

model HostApplication {
  id        Int                   @id @default(autoincrement())
  userId    Int                   @unique
  status    HostApplicationStatus @default(PENDING)
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id])

  @@map("host_applications")
}
