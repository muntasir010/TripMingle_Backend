model Payment {
  id            Int           @id @default(autoincrement())
  userId        Int
  amount        Float
  transactionId String        @unique
  status        PaymentStatus
  planId        Int?
  tripId        Int?
  receiptUrl    String?
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])
}
